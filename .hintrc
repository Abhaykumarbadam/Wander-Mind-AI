{
  "extends": [
    "development"
  ],
  "browserslist": [
    "defaults",
    "not ie 11",
    "not ios_saf <= 18.4",
    "not safari <= 18.4",
    "not samsung <= 27"
  ],
  "hints": {
    "css-prefix-order": "off",
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "video[playsinline]"
        ]
      }
    ],
    "button-type": "off"
  }
}