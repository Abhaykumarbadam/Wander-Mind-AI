# WanderMind Environment Configuration

# ═══════════════════════════════════════════════════════════════════════════
# 🔐 GOOGLE API CREDENTIALS
# ═══════════════════════════════════════════════════════════════════════════

GOOGLE_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=models/gemini-2.0-flash

# ═══════════════════════════════════════════════════════════════════════════
# 🗄️  MONGODB CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&tls=true&tlsAllowInvalidCertificates=true&appName=WanderMindAI
MONGO_DBNAME=WanderMindAI

# ═══════════════════════════════════════════════════════════════════════════
# 🔐 FIREBASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Firebase service account path (create from Firebase Console)
# This should contain your service account private key
FIREBASE_SERVICE_ACCOUNT=./wandermindauth.json

# Note: Frontend Firebase config is in Land/firebase-init.js (not committed)

# ═══════════════════════════════════════════════════════════════════════════
# 🔑 SECURITY & SECRETS
# ═══════════════════════════════════════════════════════════════════════════

# App secret key for session management (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
APP_SECRET_KEY=your-secure-secret-key-here

# ═══════════════════════════════════════════════════════════════════════════
# 🌐 CORS & ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════════════

CORS_ORIGINS=*
LOG_LEVEL=INFO
ENVIRONMENT=development
PREFER_LOCAL_EMBEDDINGS=false

# ═══════════════════════════════════════════════════════════════════════════
# 📚 EMBEDDING SETTINGS
# ═══════════════════════════════════════════════════════════════════════════

SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ═══════════════════════════════════════════════════════════════════════════
# 🗄️  CHROMA DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Mode: "local" for development (file-based), "server" for production (HTTP)
CHROMA_MODE=server

# Local mode settings (only used if CHROMA_MODE=local)
CHROMA_DIR=./chroma_db

# Server mode settings (only used if CHROMA_MODE=server)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_URL=http://localhost:8001

# API Key for Chroma Server authentication
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CHROMA_API_KEY=your-secure-chroma-api-key-here

# Collection name
CHROMA_COLLECTION_NAME=travel_kb

# ═══════════════════════════════════════════════════════════════════════════
# 📚 CHUNKING & RETRIEVAL SETTINGS
# ═══════════════════════════════════════════════════════════════════════════

CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
DEFAULT_TOP_K=6

# ═══════════════════════════════════════════════════════════════════════════
# 🌐 SERVER SETTINGS
# ═══════════════════════════════════════════════════════════════════════════

HOST=0.0.0.0
PORT=8000

# ═══════════════════════════════════════════════════════════════════════════
# 📝 NOTES
# ═══════════════════════════════════════════════════════════════════════════

# To generate secure API key:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# For development (local mode):
# CHROMA_MODE=local
# CHROMA_DIR=./chroma_db

# For production (server mode):
# CHROMA_MODE=server
# CHROMA_HOST=your-chroma-server-hostname
# CHROMA_PORT=8001
# CHROMA_URL=http://your-chroma-server:8001
# CHROMA_API_KEY=your-secure-key

# For Docker Compose:
# CHROMA_MODE=server
# CHROMA_HOST=chroma  (service name in docker-compose.yml)
# CHROMA_PORT=8000    (internal container port)
# CHROMA_URL=http://chroma:8000
