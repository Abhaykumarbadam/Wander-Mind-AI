# ==========================================
# WanderMind AI - .gitignore
# ==========================================

# ============ SECRETS & CREDENTIALS (CRITICAL) ============
# Environment variables
.env
.env.*
.env.local
.env.*.local
*.env

# Backup env files
.env.backup

# Firebase credentials (DO NOT COMMIT)
firebase-init.js
Land/firebase-init.js
wandermindauth.json
auth/serviceAccount.json

# Any credential JSON files
**/serviceAccount*.json
**/*credentials*.json
**/*auth*.json

# ============ NODE.JS / JAVASCRIPT ============
# Dependencies
node_modules/
jspm_packages/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Production builds
dist/
build/
.next/
out/

# Cache directories
.npm
.eslintcache
.cache
.parcel-cache

# Optional lock files (uncomment if you want to ignore them)
# package-lock.json
# yarn.lock

# ============ PYTHON ============
# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# pyenv
.python-version

# ============ DATABASES ============
# ChromaDB vector database storage
chroma_db/
chroma_persist/

# SQLite databases
*.sqlite3
*.db
*.sql

# MongoDB dumps
dump/
*.bson

# Database backups
*.backup
*.dump

# ============ IDE & EDITORS ============
# VSCode
.vscode/
*.code-workspace
.history/

# PyCharm / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# ============ OPERATING SYSTEMS ============
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*

# ============ PROJECT SPECIFIC ============
# Batch files (may contain local paths)
*.bat

# Temporary/test HTML files
test_*.html
**/demo.html

# Debug & diagnostic scripts
debug_*.py
diagnose_*.py
check_*.py
quick_test.py
fix_*.py
rebuild_*.py
recreate_*.py
restore_*.py
verify_*.py

# N8N workflow exports (if sensitive)
# Uncomment if needed:
# travel_search_workflow*.json

# ============ MISC ============
# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak

# Archives
*.zip
*.tar.gz
*.rar

# Certificates
*.pem
*.key
*.cert
*.crt

# Runtime data
*.pid
*.seed
*.pid.lock
